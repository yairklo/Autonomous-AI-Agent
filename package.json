{
  "name": "voice-agent",
  "version": "1.0.0",
  "description": "Personal mobile voice agent backed by a local Claude CLI server",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node scripts/start-with-bootstrap.js",
    "start:joinup-telegram": "node scripts/start-joinup-telegram.js",
    "bootstrap:workspace": "node scripts/bootstrap-workspace.js",
    "build:graph": "repomix --output .graph-context.xml && graphifyy --output .graph-context-py.json",
    "dev": "node --watch server/index.js",
    "mock": "cross-env VOICE_AGENT_MOCK=1 node server/index.js",
    "chat": "node scripts/interactive-chat.js",
    "chat:mock": "node scripts/interactive-chat.js --mock",
    "chat:restart": "node scripts/interactive-chat.js --restart",
    "smoke": "node scripts/smoke-test.js",
    "test": "node scripts/unit-tests.js && node scripts/test-whatsapp-session.js && node scripts/test-whatsapp-ingest.js",
    "test:ats": "node scripts/test-ats-submitter.js",
    "test:ats:workday": "cross-env RUN_WORKDAY_LIVE=1 HEADLESS_BROWSER=true node scripts/test-ats-submitter.js",
    "dispatch": "node scripts/dispatch-task.js",
    "test:dispatch": "node scripts/test-task-dispatch-e2e.js",
    "joinup:telegram": "node scripts/joinup-telegram-bot.js",
    "test:joinup-telegram": "node scripts/test-joinup-telegram.js",
    "test:quality-gates": "node scripts/test-dispatch-quality-gates.js",
    "test:docker-deploy": "node scripts/validate-docker-deploy.js",
    "joinup:notify-vercel": "node scripts/notify-joinup-vercel.js",
    "joinup:redeploy-staging": "node scripts/redeploy-joinup-staging.js",
    "test:redeploy-staging": "node scripts/test-redeploy-staging-mcp.js",
    "test:joinup-vercel": "node scripts/test-joinup-vercel.js",
    "test:joinup-staging": "node scripts/test-joinup-render-staging.js",
    "test:activity": "node scripts/test-activity-store.js",
    "test:run-events": "node scripts/test-cursor-log-parser.js",
    "metrics:tokens": "node scripts/metrics-tokens.js",
    "test:metrics-tokens": "node scripts/test-token-logger.js",
    "auth:cli": "node scripts/auth-cli.js",
    "auth:claude": "node scripts/auth-cli.js claude",
    "auth:cursor": "node scripts/auth-cli.js cursor",
    "auth:git": "node scripts/auth-cli.js git",
    "auth:gdrive": "node scripts/setup-gdrive-auth.js",
    "cli-auth:health": "node scripts/cli-auth-health.js",
    "test:cli-auth": "node scripts/test-cli-auth-health.js",
    "whatsapp:connect": "node scripts/connect-whatsapp.js",
    "whatsapp:groups": "node scripts/connect-whatsapp.js --list-groups --keep-alive",
    "whatsapp:inspect": "node scripts/whatsapp-inspect-groups.js",
    "whatsapp:ingest-coverage": "node scripts/whatsapp-ingest-coverage.js",
    "test:whatsapp-session": "node scripts/test-whatsapp-session.js",
    "test:whatsapp-ingest": "node scripts/test-whatsapp-ingest.js",
    "test:whatsapp-gui-track": "node scripts/test-whatsapp-gui-track.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bidi-js": "^1.0.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.0",
    "langfuse": "^3.38.20",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "playwright": "^1.54.1",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "promptfoo": "^0.121.19"
  }
}
