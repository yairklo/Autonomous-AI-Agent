# Copy to .env and fill in values (never commit .env).

PORT=8787
HOST=0.0.0.0
CLAUDE_BIN=claude
# Cursor Agent CLI binary (Linux/Coolify Docker image installs as `agent`)
CURSOR_BIN=agent
# Headless / non-interactive CLI behavior in containers
CI=1
NO_OPEN_BROWSER=1
# Git identity file path inside Coolify (persisted via git_config volume)
# GIT_CONFIG_GLOBAL=/root/.git-config-data/gitconfig

# Existing job-approval Telegram bot (WhatsApp jobs pipeline)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# joinUp Product Telegram Bot (external collaborators)
# ---------------------------------------------------------------------------
# Token from @BotFather for the dedicated joinUp collaborator bot.
JOINUP_TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Find your ID via @userinfobot or similar.
ALLOWED_TELEGRAM_USER_IDS=

# Absolute path to the joinUp repository root (Cursor Agent is pinned here).
# Local Windows (default when unset on win32):
JOINUP_PROJECT_ROOT=C:\JoinUpApp
# Coolify / Docker (set automatically in docker-compose.yml):
# JOINUP_PROJECT_ROOT=/workspaces/JoinUpApp
JOINUP_GIT_REPO=https://github.com/yairklo/JoinUpApp.git
JOINUP_GITHUB_REPO=yairklo/JoinUpApp

# GitHub PAT for non-interactive clone/push (Coolify secret). Required on VPS.
# Permissions: Contents Read/Write (classic: `repo`). Never commit the real token.
# Reused for Vercel preview lookup via GitHub Deployments API below.
GITHUB_TOKEN=

# Optional commit identity used by bootstrap + Cursor agent commits
# GIT_AUTHOR_NAME=Autonomous Agent
# GIT_AUTHOR_EMAIL=agent@example.com

# Bootstrap: SKIP=1 on local Windows if you manage the clone yourself
# WORKSPACE_BOOTSTRAP_SKIP=1
# On Coolify, STRICT is enabled in docker-compose (fail start if clone fails)
# WORKSPACE_BOOTSTRAP_STRICT=1

# Optional: mock product grilling without Claude CLI
# JOINUP_TELEGRAM_MOCK=1

# Optional: auto-start the joinUp bot when `npm start` runs
# JOINUP_TELEGRAM_AUTOSTART=1

# ---------------------------------------------------------------------------
# Coding dispatch quality gates (all Cursor coding tasks)
# ---------------------------------------------------------------------------
# After Cursor finishes, run local build/tests and re-invoke Cursor to fix failures.
# DISPATCH_MAX_FIX_LOOPS=5
# DISPATCH_AGENT_TIMEOUT_MS=1200000
# DISPATCH_GATE_TIMEOUT_MS=600000
# Merge target after gates are green (joinUp uses Dev). Use "none" to skip merge.
# DISPATCH_MERGE_TARGET=Dev
# DISPATCH_SKIP_QUALITY_GATES=0
# DISPATCH_SKIP_MERGE=0

# ---------------------------------------------------------------------------
# joinUp Vercel PREVIEW link for Dev (PR-style) — required for Telegram
# ---------------------------------------------------------------------------
# We never send production (join-up-app.vercel.app). We send the specific
# preview deployment for the Dev branch — same idea as the GitHub PR "Visit Preview".
#
# Preferred (Vercel API):
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_PROJECT_NAME=
# VERCEL_TEAM_ID=
#
# Fallback (GitHub Deployments / Checks API — same links shown on PRs):
# Uses the same GITHUB_TOKEN / JOINUP_GITHUB_REPO as above.
#
# JOINUP_VERCEL_BRANCH=Dev
# JOINUP_VERCEL_WAIT_MS=300000
# JOINUP_VERCEL_ALLOW_PRODUCTION_FALLBACK=0
#
# Manual notify script (npm run joinup:notify-vercel) — ONE chat only, never broadcast:
# JOINUP_NOTIFY_CHAT_ID=5539493039
#   or: node scripts/notify-joinup-vercel.js --chat 5539493039

# ---------------------------------------------------------------------------
# joinUp API — Render staging redeploy + health watch (after server/ changes)
# ---------------------------------------------------------------------------
# Staging (current): https://my-app-staging-ijyp.onrender.com
# Production API:    https://joinup-api.duckdns.org
# Old / unused:      https://joinupapp-1.onrender.com
#
JOINUP_STAGING_URL=https://my-app-staging-ijyp.onrender.com
JOINUP_API_PRODUCTION_URL=https://joinup-api.duckdns.org
# JOINUP_STAGING_HEALTH_PATH=/api/health
# JOINUP_STAGING_WAIT_MS=420000
# JOINUP_STAGING_GRACE_MS=90000
# Optional: wait for deploy status=live (avoids false green on old instance)
# RENDER_API_KEY=
# RENDER_STAGING_SERVICE_ID=srv-...
# JOINUP_STAGING_FORCE_REDEPLOY=0
#
# Preferred: Deploy Hook from Render Dashboard → Service → Settings → Deploy Hook
RENDER_STAGING_DEPLOY_HOOK_URL=
#
# Or Render API:
# RENDER_API_KEY=
# RENDER_STAGING_SERVICE_ID=srv-...
