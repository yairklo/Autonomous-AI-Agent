# Copy to .env and fill in values (never commit .env).

PORT=8787
HOST=0.0.0.0
CLAUDE_BIN=claude

# Existing job-approval Telegram bot (WhatsApp jobs pipeline)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# joinUp Product Telegram Bot (external collaborators)
# ---------------------------------------------------------------------------
# Token from @BotFather for the dedicated joinUp collaborator bot.
JOINUP_TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Find your ID via @userinfobot or similar.
ALLOWED_TELEGRAM_USER_IDS=

# Absolute path to the joinUp repository root (Cursor Agent is pinned here).
JOINUP_PROJECT_ROOT=C:\JoinUpApp

# Optional: mock product grilling without Claude CLI
# JOINUP_TELEGRAM_MOCK=1

# Optional: auto-start the joinUp bot when `npm start` runs
# JOINUP_TELEGRAM_AUTOSTART=1

# ---------------------------------------------------------------------------
# Coding dispatch quality gates (all Cursor coding tasks)
# ---------------------------------------------------------------------------
# After Cursor finishes, run local build/tests and re-invoke Cursor to fix failures.
# DISPATCH_MAX_FIX_LOOPS=5
# DISPATCH_AGENT_TIMEOUT_MS=1200000
# DISPATCH_GATE_TIMEOUT_MS=600000
# Merge target after gates are green (joinUp uses Dev). Use "none" to skip merge.
# DISPATCH_MERGE_TARGET=Dev
# DISPATCH_SKIP_QUALITY_GATES=0
# DISPATCH_SKIP_MERGE=0

# ---------------------------------------------------------------------------
# joinUp Vercel link (always included in Telegram completion messages)
# ---------------------------------------------------------------------------
# Stable production URL shown to collaborators after every successful build:
JOINUP_VERCEL_PRODUCTION_URL=https://join-up-app.vercel.app
# Optional: poll Vercel API for the latest READY deployment on Dev
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_PROJECT_NAME=
# VERCEL_TEAM_ID=
# JOINUP_VERCEL_BRANCH=Dev
# JOINUP_VERCEL_WAIT_MS=180000
