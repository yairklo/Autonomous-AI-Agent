# joinUp Telegram Product Bot — thin Coolify app (Telegram I/O only).
# Grill-Me + Cursor + JoinUp git live on voice-agent via /api/joinup/*.
# Use full bookworm (not slim) so we skip apt during build (Coolify OOM/kills).
FROM node:22-bookworm

USER root
WORKDIR /app

ENV NODE_ENV=development
COPY package.json package-lock.json ./
# omit optional (playwright/whatsapp) — thin bot only needs telegraf + fetch client
RUN npm install --omit=optional --omit=dev \
  && npm cache clean --force
ENV NODE_ENV=production

COPY . .

RUN mkdir -p /app/data

ENV NODE_ENV=production \
    CI=1 \
    JOINUP_THIN_BOT=1 \
    AGENT_ACTIVITY_PERSIST=0 \
    NO_OPEN_BROWSER=1

# No public HTTP port — Telegram long-polling outbound only.
# Coolify: disable HTTP healthcheck / public port for this app.
# Requires VOICE_AGENT_URL + JOINUP_BOT_SHARED_SECRET (+ bot token / allow-list).

CMD ["npm", "run", "start:joinup-telegram"]
