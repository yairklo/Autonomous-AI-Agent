# joinUp Telegram Product Bot — thin Coolify app (Telegram I/O only).
# Grill-Me + Cursor + JoinUp git live on voice-agent via /api/joinup/*.
FROM node:22-bookworm-slim

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=development
COPY package.json package-lock.json ./
RUN npm install --omit=optional
ENV NODE_ENV=production

COPY . .

RUN mkdir -p /app/data

ENV NODE_ENV=production \
    CI=1 \
    JOINUP_THIN_BOT=1 \
    AGENT_ACTIVITY_PERSIST=0 \
    NO_OPEN_BROWSER=1

# No public HTTP port — Telegram long-polling outbound only.
# Requires VOICE_AGENT_URL + JOINUP_BOT_SHARED_SECRET (+ bot token / allow-list).

CMD ["npm", "run", "start:joinup-telegram"]
